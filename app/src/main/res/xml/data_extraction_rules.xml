<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- DataStore contains auth tokens and account identifiers. -->
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <!-- Do not migrate active credentials to another device. -->
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
